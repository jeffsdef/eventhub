# Segredo para assinar tokens JWT (obrigatório em produção na Vercel)
AUTH_SECRET=altere-para-um-valor-seguro-e-aleatorio

# URL da API NestJS (backend separado conectado ao Neon PostgreSQL)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Opcional: se NEXT_PUBLIC_API_URL não estiver definida, o app usa /api (fallback Next.js)
