generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  passwordHash    String
  avatar          String?
  role            String   @default("user") // 'admin', 'organizer', 'user'
  bio             String?
  rating          Float    @default(0.0)
  interests       String[]
  pendingApproval Boolean  @default(false)
  
  // Relacionamentos
  eventsCreated   Event[]  @relation("OrganizerEvents")
  eventsConfirmed Event[]  @relation("ConfirmedEvents")
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image       String?
  category    String
  date        String
  time        String?
  location    String
  price       Float    @default(0.0)
  capacity    Int      @default(0)
  status      String   @default("upcoming")
  rating      Float    @default(0.0)
  reviews     Int      @default(0)
  featured    Boolean  @default(false)

  organizerId Int
  organizer   User     @relation("OrganizerEvents", fields: [organizerId], references: [id])
  
  confirmedUsers User[] @relation("ConfirmedEvents")
}